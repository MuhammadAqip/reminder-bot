# Salin file ini jadi .env lalu isi sesuai kebutuhan

# Koneksi database PostgreSQL
# format: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/tugas_bot"

# Token bot Telegram, dapat dari @BotFather
TELEGRAM_BOT_TOKEN="isi_token_botfather_disini"

# Nyalakan/matikan tiap platform secara independen (true/false)
# Berguna kalau HP kamu lagi tidak ada / mau jalan Telegram-only dulu, dsb.
# Minimal salah satu harus "true".
ENABLE_WHATSAPP="true"
ENABLE_TELEGRAM="true"

# Kalau diisi, bot WhatsApp CUMA merespons pesan dari 1 grup ini (misal grup kelas).
# Cara dapetin ID-nya: kosongkan dulu baris ini, jalankan bot, kirim 1 pesan apa saja
# di grup yang dimaksud, lalu lihat log terminal baris "[whatsapp] Pesan masuk dari grup: ...."
# copy ID itu (formatnya diakhiri @g.us) ke sini.
ALLOWED_WA_GROUP_ID=""

# Jam berapa cron reminder dijalankan tiap hari (format cron, default jam 7 pagi)
REMINDER_CRON_SCHEDULE="0 7 * * *"

# Timezone untuk perhitungan waktu & cron
TZ="Asia/Jakarta"
